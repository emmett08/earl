language "EAL/0.3";
environment operating_point { require "chamber" == "cold-room-C"; require "assembly" == "regulator-7"; }
tool sampled_record_adapter { version "1"; mode deterministic; }
evidence sampled_record { tool sampled_record_adapter; kind trace; environment operating_point; max_age 3600; require "schema" == "EAL/typed-input/1"; }

reasoning bounded_trace { method "temporal/1"; rationale "Check the declared finite sampled trace for the fixed less-than-one property; a computed violation is a usable negative finding."; }
claim sampled_property_violated { statement "The fully covered sampled trace contains a value that violates the specified less-than-one property."; environment operating_point;
 proposition { subject "regulator-7"; quantity "dimensionless"; unit "1"; scope "normalised-vibration-C"; valid_from "2040-01-31T08:00:00Z"; valid_until "2040-01-31T09:00:00Z"; query {"start": 0, "end": 12, "max_gap": 4, "property": {"operator": "lt", "value": 1}, "semantics": "sampled"}; result "holds" == false; }
}
argument violation_route { conclusion sampled_property_violated; reasoning bounded_trace; evidence sampled_record; binding sampled_record; }
