language "EAL/0.3";
environment operating_point { require "chamber" == "cold-room-C"; require "assembly" == "regulator-7"; }
tool response_test_adapter { version "1"; mode deterministic; }
evidence response_test { tool response_test_adapter; kind measurement; environment operating_point; max_age 3600; require "passed" == true; }
tool countermeasurement_adapter { version "1"; mode deterministic; }
evidence countermeasurement { tool countermeasurement_adapter; kind measurement; environment operating_point; max_age 3600; require "passed" == true; }
tool instrument_diagnosis_adapter { version "1"; mode deterministic; }
evidence instrument_diagnosis { tool instrument_diagnosis_adapter; kind measurement; environment operating_point; max_age 3600; require "passed" == true; }

reasoning response_step { mode structured; rationale "The response test supplies the stated property under the operating point."; }
reasoning diagnosis_step { mode structured; rationale "The supplied instrument check supports the defect claim for this countermeasurement instrument."; }
claim response_supported { statement "The response test supplies uncontested support for the stated regulator property."; environment operating_point; }
claim instrument_fault { statement "The instrument used for the countermeasurement has the diagnosed defect."; environment operating_point; }
argument response_route { conclusion response_supported; reasoning response_step; evidence response_test; }
argument diagnosis_route { conclusion instrument_fault; reasoning diagnosis_step; evidence instrument_diagnosis; }
objection response_challenge { target argument response_route; evidence countermeasurement; }
objection instrument_defence { target objection response_challenge; premises response_supported; }
