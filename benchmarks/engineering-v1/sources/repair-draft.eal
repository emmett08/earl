language "EAL/0.1";
environment bench { require "site" == "bench"; require "revision" == "A"; }
tool logic_tool { version "1"; mode deterministic; }
evidence logic { tool logic_tool; kind logical_case; environment bench; max_age 7200; require "conclusion" == "within_limit"; }
tool applicability_tool { version "1"; mode deterministic; }
evidence applicability { tool applicability_tool; kind measurement; environment bench; max_age 7200; require "passed" == true; }
tool measured_tool { version "1"; mode deterministic; }
evidence measured { tool measured_tool; kind measurement; environment bench; max_age 7200; require "passed" == true; }

reasoning entailment { mode deductive; rationale "The stated model premises entail the within-limit atom."; require "entailed" == true; }
reasoning applicability_step { mode structured; rationale "The declared applicability test supplies bounded support for this model instance."; }
reasoning joint_step { mode structured; rationale "For this apparatus and trial, the model result, applicability test and observed check jointly supply support."; }
claim model_result { statement "Within the supplied propositional model, the within-limit conclusion follows."; environment bench; }
claim model_applies { statement "The declared model-applicability check passes for revision A."; environment bench; }
claim trial_supported { statement "The model and measured check support the revision A bench trial."; environment bench; }
argument model_argument { conclusion model_result; reasoning entailment; evidence logic; }
argument applicability_argument { conclusion model_applies; reasoning applicability_step; evidence applicability; }
argument combined_argument { conclusion trial_supported; reasoning joint_step; evidence measured; premises model_result, missing_applicability; }
