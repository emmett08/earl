language "EAL/2";
environment bench { require "site" == "bench"; require "revision" == "A"; }
tool joint_measurement_tool { version "1"; mode deterministic; }
evidence joint_measurement { tool joint_measurement_tool; kind hypotheses; environment bench; max_age 7200; require "observed" == "joint-record"; }

reasoning diagnose_sensor { method "abductive/1"; rationale "Bayes update over the supplied joint observation; evidence reused as backing is the same observation, not an independent sample."; backing joint_measurement; require "best" == "sensor"; }
reasoning diagnose_connector { method "abductive/1"; rationale "Compare the same mutually exclusive candidate set using one supplied joint likelihood per candidate."; backing joint_measurement; require "best" == "connector"; }
claim sensor_ranked { statement "Sensor fault has the largest posterior within this supplied candidate set."; environment bench; }
claim connector_ranked { statement "Connector fault has the largest posterior within this supplied candidate set."; environment bench; }
argument sensor_argument { conclusion sensor_ranked; reasoning diagnose_sensor; evidence joint_measurement; }
argument connector_argument { conclusion connector_ranked; reasoning diagnose_connector; evidence joint_measurement; }
