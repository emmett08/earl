language "EAL/2";
environment task_scope {
  require "machine" == "dryer-11";
  require "model" == "D2";
}
tool numerical_reader { version "1"; mode deterministic; }
evidence numerical_input { tool numerical_reader; kind causal_model; environment task_scope; max_age 1800; require "schema" == "EAL/typed-input/1"; }
reasoning numerical_step { method "counterfactual/1"; rationale "Evaluate the named finite method on this exact query and attached record; the computation does not verify physical interpretation or source authenticity."; }
claim computed_record {
  statement "Within the supplied affine dryer model and its fixed exogenous terms, does setting heater_power to 4 predict outlet_delta at most 9 K?";
  environment task_scope;
  proposition {
    subject "dryer-11";
    quantity "temperature_difference";
    unit "K";
    scope "model-D2";
    valid_from "2026-09-24T12:00:00Z";
    valid_until "2026-09-24T12:09:00Z";
    query {"intervention":{"value":4,"variable":"heater_power"},"outcome":"outlet_delta","variables":{"heater_power":{"coefficients":{},"intercept":2,"noise":0},"outlet_delta":{"coefficients":{"heater_power":2},"intercept":1,"noise":0}}};
    result "counterfactual" <= 9;
  }
}
argument measured_route { conclusion computed_record; reasoning numerical_step; evidence numerical_input; binding numerical_input; }
