language "EAL/2";
environment task_scope {
  require "bench" == "assembly-7";
  require "candidate" == "C21";
}
tool numerical_reader { version "1"; mode deterministic; }
evidence numerical_input { tool numerical_reader; kind analogy; environment task_scope; max_age 1800; require "schema" == "EAL/typed-input/1"; }
reasoning numerical_step { method "analogical/1"; rationale "Evaluate the named finite method on this exact query and attached record; the computation does not verify physical interpretation or source authenticity."; }
claim computed_record {
  statement "For the four predeclared fixture features, does candidate C21 match at least three quarters of the reference values exactly?";
  environment task_scope;
  proposition {
    subject "C21";
    quantity "dimensionless";
    unit "1";
    scope "feature-check-C21";
    valid_from "2026-09-24T12:00:00Z";
    valid_until "2026-09-24T12:09:00Z";
    query {"relevant_features":["mount","drive","diameter","firmware"],"source":{"diameter":12,"drive":"dual","firmware":"A","mount":"M6"},"target":{"diameter":12,"drive":"dual","firmware":"B","mount":"M6"}};
    result "match_fraction" >= 0.75;
  }
}
argument measured_route { conclusion computed_record; reasoning numerical_step; evidence numerical_input; binding numerical_input; }
