language "EAL/2";
environment task_scope {
  require "line" == "converter-4";
  require "episode" == "F8";
}
tool numerical_reader { version "1"; mode deterministic; }
evidence numerical_input { tool numerical_reader; kind hypotheses; environment task_scope; max_age 1800; require "schema" == "EAL/typed-input/1"; }
reasoning numerical_step { method "abductive/1"; rationale "Evaluate the named finite method on this exact query and attached record; the computation does not verify physical interpretation or source authenticity."; }
claim computed_record {
  statement "For the stipulated finite fault model given the phase-alert pattern, is the leading fault hypothesis posterior at least 0.70?";
  environment task_scope;
  proposition {
    subject "converter-4";
    quantity "probability";
    unit "1";
    scope "fault-model-F8";
    valid_from "2026-09-24T12:00:00Z";
    valid_until "2026-09-24T12:09:00Z";
    query {"candidates":[{"likelihood":0.8,"name":"sensor","prior":0.6},{"likelihood":0.2,"name":"winding","prior":0.4}],"observed":"phase_alert"};
    result "best_posterior" >= 0.7;
  }
}
argument measured_route { conclusion computed_record; reasoning numerical_step; evidence numerical_input; binding numerical_input; }
