language "EAL/2";
environment task_scope {
  require "robot" == "arm-12";
  require "move" == "K9";
}
tool trace_reader { version "1"; mode deterministic; }
evidence trace_input { tool trace_reader; kind sampled_negative_trace; environment task_scope; max_age 1800; require "schema" == "EAL/typed-input/1"; }
reasoning sampled_step { method "engineering/sampled-negative/1"; rationale "A finite sampled negative finding is conditioned on sample coverage and detector capability; no continuous-time or physical truth follows from this imported trace."; }
claim sampled_finding {
  statement "Did at least one finite robot-axis displacement sample exceed the declared 11 mm ceiling?";
  environment task_scope;
  proposition {
    subject "arm-12";
    quantity "length";
    unit "mm";
    scope "axis-displacement-K9";
    valid_from "2026-09-24T12:00:00Z";
    valid_until "2026-09-24T12:09:00Z";
    query {"detector_contract":{"maximum_detection_limit":10,"minimum_sensitivity":0.8},"end":7,"max_gap":2,"mode":"counterexample","property":{"operator":"le","value":11},"semantics":"sampled","start":0};
    result "finding" == true;
  }
}
argument sampled_route { conclusion sampled_finding; reasoning sampled_step; evidence trace_input; binding trace_input; }
