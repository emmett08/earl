language "EAL/2";
environment task_scope {
  require "cluster" == "db-east";
  require "shard" == "S12";
}
tool test_reader { version "1"; mode deterministic; }
evidence test { tool test_reader; kind measurement; environment task_scope; max_age 1800;
  require "renewal_ms" <= 150;
  require "passed" == true;
}
tool alert_reader { version "1"; mode deterministic; }
evidence timeout { tool alert_reader; kind measurement; environment task_scope; max_age 1800;
  require "event" == "timeout_alert";
  require "active" == true;
}
tool diagnosis_reader { version "1"; mode deterministic; }
evidence trace { tool diagnosis_reader; kind measurement; environment task_scope; max_age 1800;
  require "origin" == "injector_origin";
  require "independently_checked" == true;
}
reasoning test_step { method "structured/1"; rationale "The finite test log supports its explicitly bounded result, conditional on the authored inference and acquisition identity."; }
claim operational_record { statement "The S12 lease-renewal test completed within 150 ms."; environment task_scope; }
argument primary_test { conclusion operational_record; reasoning test_step; evidence test; }
objection recorded_alert { target reasoning test_step; evidence timeout; }
reasoning diagnostic_step { method "structured/1"; rationale "The separate diagnosis records the stipulated origin of the alert; physical sufficiency remains authored."; }
claim diagnostic_confirmed { statement "The separate diagnostic report identifies the alert source for this episode."; environment task_scope; }
argument diagnostic_route { conclusion diagnostic_confirmed; reasoning diagnostic_step; evidence trace; }
objection diagnostic_defence { target objection recorded_alert; premises diagnostic_confirmed; }
