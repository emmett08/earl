language "EAL/2";
environment task_scope {
  require "service" == "task-queue";
  require "cohort" == "Q7";
}
tool numerical_reader { version "1"; mode deterministic; }
evidence numerical_input { tool numerical_reader; kind sample; environment task_scope; max_age 1800; require "schema" == "EAL/typed-input/1"; }
reasoning numerical_step { method "inductive/1"; rationale "Evaluate the named finite method on this exact query and attached record; the computation does not verify physical interpretation or source authenticity."; }
claim computed_record {
  statement "Under the stated binomial sampling model, does the 95% Wilson lower bound for successful queue acknowledgements in 400 trials exceed 0.96?";
  environment task_scope;
  proposition {
    subject "queue-Q7";
    quantity "probability";
    unit "1";
    scope "ack-Q7-400";
    valid_from "2026-09-24T12:00:00Z";
    valid_until "2026-09-24T12:09:00Z";
    query {"confidence":0.95};
    result "lower" > 0.96;
  }
}
argument measured_route { conclusion computed_record; reasoning numerical_step; evidence numerical_input; binding numerical_input; }
