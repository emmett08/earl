language "EAL/2";
environment task_scope {
  require "substation" == "N10";
  require "relay" == "R17";
}
tool relay_reader { version "1"; mode deterministic; }
evidence trip {
  tool relay_reader; kind test; environment task_scope; max_age 1800;
  require "pulse_a" >= 610;
  require "trip_ms" < 45;
  require "commissioning" == "C7";
}
reasoning registered_record { method "structured/1"; rationale "These imported records report only the stated bounded test, identity and operating point; the acquisition assertion requires independent authentication."; }
claim accepted_record { statement "The R17 record reports a qualifying commissioned trip."; environment task_scope; }
argument source_report { conclusion accepted_record; reasoning registered_record; evidence trip; }
