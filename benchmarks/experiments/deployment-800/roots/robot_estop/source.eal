language "EAL/2";
environment run_scope {
  require "asset" == "RX-12";
  require "trial" == "stop-test-E3";
}
tool primary_reader { version "1"; mode deterministic; }
tool alternate_reader { version "1"; mode deterministic; }
tool alert_reader { version "1"; mode deterministic; }
tool resolution_reader { version "1"; mode deterministic; }
evidence primary_record {
  tool primary_reader; kind test; environment run_scope; max_age 900;
  require "asset" == "RX-12";
  require "trial" == "stop-test-E3";
  require "stop_p99_ms" <= 110;
  require "coverage_pct" >= 100;
  require "bypass" == false;
}
evidence alternate_record {
  tool alternate_reader; kind independent_check; environment run_scope; max_age 900;
  require "asset" == "RX-12";
  require "trial" == "stop-test-E3";
  require "finding" == "independent_qualified";
  require "stop_p99_ms" <= 110;
  require "coverage_pct" >= 100;
  require "bypass" == false;
}
evidence current_alert {
  tool alert_reader; kind monitoring; environment run_scope; max_age 900;
  require "asset" == "RX-12";
  require "finding" == "primary_interlock_bypass";
}
evidence independent_resolution {
  tool resolution_reader; kind independent_check; environment run_scope; max_age 900;
  require "asset" == "RX-12";
  require "trial" == "stop-test-E3";
  require "finding" == "harness_only_event";
}
reasoning submitted_record {
  method "structured/1";
  rationale "The primary and separately acquired alternative tests independently report the stated finite robot emergency-stop result. The current alert challenges only the primary test. The resolution answers that primary alert for this trial. Acquisition records alone do not authenticate the physical system.";
}
claim estop_record {
  statement "For RX-12 trial stop-test-E3, a qualifying primary or independent alternative test reports stop p99 at most 110 ms, full monitored coverage and no bypass; the primary test is subject to its specific alert and resolution.";
  environment run_scope;
}
argument positive_route { conclusion estop_record; reasoning submitted_record; evidence primary_record; }
argument independent_route { conclusion estop_record; reasoning submitted_record; evidence alternate_record; }
objection adverse_finding { target argument positive_route; evidence current_alert; }
objection separate_resolution { target objection adverse_finding; evidence independent_resolution; }
