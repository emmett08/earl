language "EAL/2";
environment fan_rig {
  require "facility" == "North-1";
  require "unit" == "AH-73";
}
tool probe_reader { version "1"; mode deterministic; }
tool alignment_reader { version "1"; mode deterministic; }
evidence direction_record {
  tool probe_reader; kind test; environment fan_rig; max_age 3600;
  require "unit" == "AH-73";
  require "drive_firmware" == "r17";
  require "programme" == "warm_restart";
  require "direction" == "forward";
  require "pass" == true;
}
evidence alignment_notice {
  tool alignment_reader; kind inspection; environment fan_rig; max_age 3600;
  require "unit" == "AH-73";
  require "finding" == "fixture_misalignment";
}
reasoning bench_relation {
  method "structured/1";
  rationale "A passing, correctly identified bench record is an authored ground for the recorded direction claim. The source does not authenticate the physical actuator.";
}
claim recorded_direction {
  statement "Within the North-1 bench fixture and declared procedure, the AH-73 r17 warm-restart test demonstrated forward shaft direction.";
  environment fan_rig;
}
argument matching_test {
  conclusion recorded_direction; reasoning bench_relation; evidence direction_record;
}
objection suspect_fixture {
  target argument matching_test; evidence alignment_notice;
}
