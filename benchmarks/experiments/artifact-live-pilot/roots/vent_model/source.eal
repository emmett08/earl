language "EAL/2";
environment controller {
  require "fixture" == "vent-controller-6";
  require "recipe" == "R5";
}
tool model_reader { version "1"; mode deterministic; }
evidence affine_model {
  tool model_reader; kind causal_model; environment controller; max_age 3600;
  require "intervention.variable" == "valve_drive";
  require "intervention.value" == 5;
  require "outcome" == "vent_load";
}
reasoning bounded_intervention {
  method "counterfactual/1";
  rationale "Compute the vent-load index for an intervention setting valve_drive to five within each supplied acyclic affine model, retaining that model's stated noise values. The supplied model is not physically validated here.";
  require "counterfactual" <= 8;
}
claim intervention_within_limit {
  statement "Under the supplied affine vent-controller model and its fixed exogenous values, setting valve_drive to five gives a vent-load index no greater than eight.";
  environment controller;
}
argument model_calculation {
  conclusion intervention_within_limit; reasoning bounded_intervention; evidence affine_model;
}
