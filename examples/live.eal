language "EAL/2";
environment local { require "workload" == "sha256"; }
tool inspect_input { version "1"; mode deterministic; }
tool benchmark { version "1"; mode nondeterministic; }
evidence workload_shape {
  tool inspect_input; kind configuration; environment local; max_age 300;
  input {"iterations": 10000};
  require "iterations" == 10000;
}
evidence elapsed_time {
  tool benchmark; kind measurement; environment local; max_age 300;
  input {"iterations": 10000};
  require "elapsed_ms" < 5000;
}
reasoning measured_duration {
  method "structured/1";
  rationale "A recorded duration supports only the duration claim about this execution on this host.";
}
claim execution_duration {
  statement "This 10000-iteration SHA-256 execution completed in less than 5000 ms on the current host.";
  environment local;
}
argument measured_execution {
  conclusion execution_duration; reasoning measured_duration;
  evidence workload_shape, elapsed_time;
}
