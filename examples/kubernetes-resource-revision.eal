// Synthetic Kubernetes episode. This source does not describe a real cluster.
language "EAL/2";
environment checkout_profile {
  require "cluster_uid" == "synthetic-cluster-A";
  require "namespace" == "payments";
  require "workload" == "checkout-api";
  require "node_pool" == "shared-A";
  require "target_rps" == 200;
  require "node_uid" == "node-17";
  require "target_pod_uid" == "checkout-pod-7";
}

tool build_attestation_reader { version "1"; mode deterministic; }
tool kube_rollout_reader { version "1"; mode deterministic; }
tool load_sample_reader { version "1"; mode nondeterministic; }
tool latency_trace_reader { version "1"; mode nondeterministic; }
tool sampling_manifest_reader { version "1"; mode deterministic; }
tool telemetry_manifest_reader { version "1"; mode deterministic; }
tool kube_capacity_reader { version "1"; mode deterministic; }
tool monitor_coverage_reader { version "1"; mode deterministic; }
tool contention_reader { version "1"; mode nondeterministic; }

evidence build_attestation {
  tool build_attestation_reader; kind provenance; environment checkout_profile; max_age 14400;
  input {"image_digest":"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"};
  require "source_commit" == "9f4c7a1";
  require "image_digest" == "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";
  require "signature_verified" == true;
}
evidence rollout_snapshot {
  tool kube_rollout_reader; kind configuration; environment checkout_profile; max_age 180;
  input {"deployment":"checkout-api","namespace":"payments"};
  require "cluster_uid" == "synthetic-cluster-A";
  require "deployment_uid" == "deployment-42";
  require "observed_generation" >= 12;
  require "ready_replicas" >= 3;
  require "ready_endpoints" >= 3;
  require "node_uid" == "node-17";
  require "target_pod_uid" == "checkout-pod-7";
  require "image_digest" == "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";
}
evidence sampled_responses {
  tool load_sample_reader; kind sample; environment checkout_profile; max_age 180;
  input {"duration_s":300,"image_digest":"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa","route":"checkout-create","target_rps":200};
  require "trials" == 10000;
  require "confidence" == 0.95;
}
evidence sampled_p99 {
  tool latency_trace_reader; kind trace; environment checkout_profile; max_age 180;
  input {"duration_s":300,"route":"checkout-create","target_rps":200};
  require "semantics" == "sampled";
}
evidence sampling_manifest {
  tool sampling_manifest_reader; kind documentation; environment checkout_profile; max_age 180;
  require "complete" == true;
  require "route" == "checkout-create";
  require "sampled_count" == 10000;
}
evidence telemetry_manifest {
  tool telemetry_manifest_reader; kind documentation; environment checkout_profile; max_age 180;
  require "complete" == true;
  require "histogram_unit" == "ms";
  require "target_pod_uid" == "checkout-pod-7";
}
evidence scheduler_snapshot {
  tool kube_capacity_reader; kind configuration; environment checkout_profile; max_age 180;
  require "node_uid" == "node-17";
  require "allocatable_cpu_milli" >= 8000;
  require "headroom_requests_milli" >= 1000;
  require "hpa_current_replicas" >= 3;
  require "target_pod_uid" == "checkout-pod-7";
}
evidence monitor_manifest {
  tool monitor_coverage_reader; kind monitoring; environment checkout_profile; max_age 180;
  require "complete" == true;
  require "node_uid" == "node-17";
  require "target_pod_uid" == "checkout-pod-7";
  require "query_complete" == true;
}
evidence observed_contention {
  tool contention_reader; kind monitoring; environment checkout_profile; max_age 180;
  require "finding" == "co_tenant_cpu_competition";
  require "node_uid" == "node-17";
  require "target_pod_uid" == "checkout-pod-7";
  require "query_complete" == true;
  require "batch_request_milli" <= 200;
  require "batch_cpu_milli" >= 2500;
  require "target_throttled_ratio" >= 0.20;
}

assumption sampling_applicable {
  statement "The named generator route, request selection and recorded 10000 responses describe the five-minute trial; independent Bernoulli trials remain an unverified statistical modelling choice.";
  environment checkout_profile; validate sampling_manifest;
  valid_from "2026-09-24T10:00:00Z"; valid_until "2026-09-24T14:00:00Z";
}
assumption telemetry_applicable {
  statement "The p99 sequence belongs to the named route and target pod with millisecond units for this trial.";
  environment checkout_profile; validate telemetry_manifest;
  valid_from "2026-09-24T10:00:00Z"; valid_until "2026-09-24T14:00:00Z";
}
assumption monitored_profile {
  statement "The monitor covered the target pod and shared node during the trial. This does not establish that it detected every possible interference mechanism.";
  environment checkout_profile; validate monitor_manifest;
  valid_from "2026-09-24T10:00:00Z"; valid_until "2026-09-24T14:00:00Z";
}

reasoning identity_step {
  method "structured/1";
  rationale "The attested build and current Kubernetes deployment snapshot identify the exact image, selected endpoint set and rollout generation. This authored correspondence requires independent provenance review.";
}
reasoning sampled_success_step {
  method "inductive/1";
  rationale "Compute the Wilson lower 95 percent bound for the 10000 recorded binary outcomes under the stated binomial model; the method does not verify the model.";
  require "lower" > 0.998;
}
reasoning sampled_latency_step {
  method "temporal/1";
  rationale "Check the finite sequence of sampled p99 values at 0, 100, 200 and 300 seconds, including interval coverage. This does not establish the intervening or future values.";
  require "holds" == true;
}
reasoning scheduler_accounting_step {
  method "structured/1";
  rationale "The Kubernetes snapshot reports requested CPU headroom and current replica count. Requests are a scheduler input, not a bound on actual co-tenant CPU consumption.";
}
reasoning canary_composition {
  method "structured/1";
  rationale "The two computed observations jointly support a bounded description of this five-minute trial only.";
}
reasoning operating_inference {
  method "structured/1";
  rationale "The exact build, finite canary and scheduler accounting supply a defeasible basis to operate for the next fifteen minutes under the named 200-rps profile. Any new resource-intensive co-tenant or traffic mix change requires a fresh trial and challenge review.";
}

claim deployed_build {
  statement "The reviewed synthetic checkout build 9f4c7a1 is the image reported for three ready checkout endpoints in this cluster snapshot.";
  environment checkout_profile;
}
claim sampled_success {
  statement "For this trial's 10000 recorded responses, the Wilson lower 95 percent bound on success proportion exceeds 0.998 under the specified binomial model.";
  environment checkout_profile;
}
claim sampled_latency {
  statement "The four sampled 100-second p99 measurements in this five-minute trial are at most 150 ms, with full declared sample coverage.";
  environment checkout_profile;
}
claim requested_headroom {
  statement "The Kubernetes snapshot reports at least 1000 millicores of request headroom on node-17 and three current replicas.";
  environment checkout_profile;
}
claim bounded_canary {
  statement "The recorded checkout-create trial targeting checkout-pod-7 at 200 rps satisfies the specified sampled success and latency criteria for its five-minute observation window.";
  environment checkout_profile;
}
claim provisional_operating_basis {
  statement "At assessment time, the observations supply a defeasible basis to consider a fifteen-minute operation of checkout-pod-7 with this exact build at the named profile, conditional on unchanged workload mix and resource interference.";
  environment checkout_profile;
}

argument build_identity {
  conclusion deployed_build; reasoning identity_step;
  evidence build_attestation, rollout_snapshot;
}
argument success_sample {
  conclusion sampled_success; reasoning sampled_success_step;
  evidence sampled_responses; assumptions sampling_applicable;
}
argument latency_sample {
  conclusion sampled_latency; reasoning sampled_latency_step;
  evidence sampled_p99; assumptions telemetry_applicable;
}
argument scheduler_accounting {
  conclusion requested_headroom; reasoning scheduler_accounting_step;
  evidence scheduler_snapshot;
}
argument canary_result {
  conclusion bounded_canary; reasoning canary_composition;
  premises sampled_success, sampled_latency;
}
argument operating_route {
  conclusion provisional_operating_basis; reasoning operating_inference;
  assumptions monitored_profile;
  premises deployed_build, bounded_canary, requested_headroom;
}
objection batch_cpu_interference {
  target reasoning operating_inference;
  evidence observed_contention;
}
