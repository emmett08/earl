// One historical, exact GitHub Actions run. The live collector is required to assess it.
language "EAL/2";

environment github {
  require "repository" == "emmett08/earl";
  require "decision" == "workflow-result";
}
tool github_workflow { version "1"; mode nondeterministic; }

evidence workflow_result {
  tool github_workflow; kind test; environment github; max_age 300;
  input {
    "repository": "emmett08/earl",
    "workflow_id": 365107869,
    "workflow_path": ".github/workflows/test.yml",
    "run_id": 36133531512,
    "run_attempt": 1,
    "head_sha": "a9cdabee643118ff3ae28b3ec5c346427cca8cad",
    "created_at": "2026-09-25T12:11:37Z",
    "event": "push",
    "head_branch": "main",
    "required_jobs": {"test": ["Run make check", "Run make build"]}
  };
  require "identity_matches" == true;
  require "latest_attempt" == true;
  require "acquisition" == "live_api";
  require "run_status" == "completed";
  require "run_conclusion" == "success";
  require "all_jobs_success" == true;
  require "required_steps_success" == true;
}

reasoning github_run_warrant {
  method "structured/1";
  rationale "The GitHub REST response for this exact run and latest attempt records a successful completed workflow, all jobs and the two named steps. It supports a bounded report of GitHub's run status, not the correctness of the software or the authority of an unverified producer.";
}
claim workflow_passed {
  statement "GitHub Actions reported that run 36133531512 attempt 1 of .github/workflows/test.yml for commit a9cdabee643118ff3ae28b3ec5c346427cca8cad completed successfully, including its test job, make check and make build steps.";
  environment github;
}
argument checked_run {
  conclusion workflow_passed; reasoning github_run_warrant; evidence workflow_result;
}
