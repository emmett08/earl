// Synthetic API load-test fixture.
language "EAL/3"

environment test_run {
  require service == "orders-api"
  require build_id == "demo-build-42"
  require dataset == "synthetic"
}

tool aspic_fixture {
  version "1"
}

context environment test_run, tool aspic_fixture, max_age 3600.0 {
  evidence checked_record {
    kind test
    input {"run_id": "demo-load-001"}
    require checked == true
  }

  evidence latency_record {
    kind test
    input {"run_id": "demo-load-001"}
    require within_limit == true
  }

  evidence gap_record {
    kind test
    input {"run_id": "demo-load-001"}
    require gap_found == true
  }

  evidence probe_record {
    kind test
    input {"run_id": "demo-load-001"}
    require within_limit == true
  }

  reasoning recorded {
    method "structured/1"
    rationale "The stipulated finding concerns only the identified synthetic run."
  }

  claim report_checked {
    statement "The synthetic report identity was checked."
  }

  claim latency_ok {
    statement "The synthetic primary latency sample meets its limit."
  }

  claim trace_gap {
    statement "The synthetic diagnostic reports a primary trace gap."
  }

  claim alternate_probe_ok {
    statement "An independent synthetic probe for this run meets its latency limit."
  }

  claim run_passes {
    statement "The synthetic run meets the stated criterion through an accepted route."
  }

  argument report_arg = [evidence checked_record] via recorded => report_checked

  argument latency_arg = [evidence latency_record] via recorded => latency_ok

  argument gap_arg = [evidence gap_record] via recorded => trace_gap

  argument primary_run = [premises report_checked, latency_ok] via recorded => run_passes

  argument independent_probe = [premises alternate_probe_ok] via recorded => run_passes

  pattern observation_route(c: claim, r: reasoning, e: evidence) = [evidence e] via r => c

  apply probe_arg = observation_route(c=alternate_probe_ok, r=recorded, e=probe_record)

  objection primary_trace_gap = [premises trace_gap] -x> argument primary_run

  strict report_arg reviewed "synthetic-review/checked-record-implication"

  rank independent_probe 700 reviewed "synthetic-review/independent-probe"

  rank probe_record 700 reviewed "synthetic-review/probe-observation"
}
