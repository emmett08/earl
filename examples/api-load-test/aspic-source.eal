// Synthetic API load-test fixture.
language "EAL/2"

environment test_run {
  require service == "orders-api"
  require build_id == "demo-build-42"
  require dataset == "synthetic"
}

tool aspic_fixture {
  version "1"
}

context environment test_run, tool aspic_fixture, max_age 3600.0 {
  evidence formal_theory {
    kind aspic_theory
    input {"run_id": "demo-load-001"}
    require schema == "EAL/typed-input/1"
  }

  evidence checked_record {
    kind test
    input {"run_id": "demo-load-001"}
    require checked == true
  }

  evidence latency_record {
    kind test
    input {"run_id": "demo-load-001"}
    require within_limit == true
  }

  evidence gap_record {
    kind test
    input {"run_id": "demo-load-001"}
    require gap_found == true
  }

  evidence probe_record {
    kind test
    input {"run_id": "demo-load-001"}
    require within_limit == true
  }

  reasoning recorded {
    method "structured/1"
    rationale "The stipulated synthetic fixture supplies a bounded finding for the named run."
  }

  reasoning formal_conflict {
    method "argumentation/aspic/1"
    rationale "The specified strict and defeasible rules and their undercut resolve the synthetic run-level conflict."
  }

  claim report_checked {
    statement "The synthetic report identity was checked."
  }

  claim latency_ok {
    statement "The synthetic primary latency sample meets its limit."
  }

  claim trace_gap {
    statement "The synthetic diagnostic reports a primary trace gap."
  }

  claim alternate_probe_ok {
    statement "An independent synthetic probe for this run meets the same latency limit."
  }

  claim run_passes {
    statement "For the synthetic fixture, the formal grounded theory accepts this run-level claim via the independent probe."
    proposition {
      subject "orders-api"
      quantity "proposition"
      unit "1"
      scope "demo-load-001"
      valid_from "2026-09-25T10:00:00Z"
      valid_until "2026-09-25T10:00:01Z"
      query {"theory": {"contraries": [{"attacker": "~applicable_pass", "target": "applicable_pass"}], "goal": "run_passes", "premises": [{"atom": "report_checked", "kind": "axiom"}, {"atom": "latency_ok", "kind": "ordinary", "rank": 6}, {"atom": "trace_gap", "kind": "ordinary", "rank": 1}, {"atom": "alternate_probe_ok", "kind": "ordinary", "rank": 8}], "rules": [{"antecedents": ["report_checked", "latency_ok"], "consequent": "run_passes", "id": "r_pass", "kind": "defeasible", "name": "applicable_pass", "rank": 7}, {"antecedents": ["trace_gap"], "consequent": "~applicable_pass", "id": "r_gap", "kind": "strict"}, {"antecedents": ["alternate_probe_ok"], "consequent": "run_passes", "id": "r_probe", "kind": "defeasible", "name": "applicable_probe", "rank": 8}]}}
      result grounded_accepted == true
    }
  }

  argument report_arg = [evidence checked_record] via recorded => report_checked

  argument latency_arg = [evidence latency_record] via recorded => latency_ok

  argument gap_arg = [evidence gap_record] via recorded => trace_gap

  argument probe_arg = [evidence probe_record] via recorded => alternate_probe_ok

  argument formal_run = [evidence formal_theory, premises report_checked, latency_ok, trace_gap, alternate_probe_ok] via formal_conflict => run_passes binding formal_theory
}
