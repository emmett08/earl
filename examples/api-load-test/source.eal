// Teaching data: this argument assesses the supplied synthetic report.
language "EAL/2";

environment test_run {
  require "service" == "orders-api";
  require "build_id" == "demo-build-42";
  require "dataset" == "synthetic";
}

tool load_test_report { version "1"; mode deterministic; }

evidence load_test {
  tool load_test_report; kind test; environment test_run; max_age 86400;
  input {
    "service": "orders-api",
    "build_id": "demo-build-42",
    "run_id": "demo-load-001",
    "concurrent_clients": 10,
    "dataset": "synthetic",
    "report_sha256": "0ed808bf1858159172a3fd79dd818c842079f47fa9bb6a0c7e300e41a90b152d"
  };
  require "request_count" >= 100;
  require "p95_ms" <= 200;
  require "error_rate_percent" <= 1;
}

reasoning acceptance_criteria {
  method "structured/1";
  rationale "The collector checks the report identity and computes nearest-rank p95 latency over all recorded requests. Every non-2xx status or transport failure counts towards the error rate. Meeting both thresholds in a report of at least 100 requests supports the stated claim about that report. Applying it to a deployed service would additionally require genuine, complete measurements and a representative workload.";
}

claim performance_criteria_met {
  statement "The synthetic report demo-load-001 for orders-api build demo-build-42, labelled with 10 concurrent clients, records at least 100 requests with sample p95 latency at most 200 ms and an error rate at most 1 percent.";
  environment test_run;
}

argument checked_performance {
  conclusion performance_criteria_met;
  reasoning acceptance_criteria;
  evidence load_test;
}
