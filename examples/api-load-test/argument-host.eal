// Synthetic teaching fixture: a fresh recomputation, not a new load test.
language "EAL/2";

environment bundled_fixture {
  require "service" == "orders-api";
  require "build_id" == "demo-build-42";
  require "dataset" == "synthetic";
}

tool fixture_recompute { version "1"; mode deterministic; }

evidence recomputed_sample {
  tool fixture_recompute; kind test; environment bundled_fixture; max_age 120;
  input {
    "service": "orders-api",
    "build_id": "demo-build-42",
    "run_id": "demo-load-001",
    "concurrent_clients": 10,
    "dataset": "synthetic",
    "report_sha256": "0ed808bf1858159172a3fd79dd818c842079f47fa9bb6a0c7e300e41a90b152d"
  };
  require "request_count" >= 100;
  require "p95_ms" <= 200;
  require "error_rate_percent" <= 1;
}

reasoning sample_criteria {
  method "structured/1";
  rationale "The host recomputes sample statistics from the pinned synthetic fixture. This says nothing about a current deployed service or the population failure rate.";
}

claim fixture_criteria_met {
  statement "A current recomputation of the bundled synthetic fixture records at least 100 requests, sample p95 at most 200 ms and an error rate at most 1 percent.";
  environment bundled_fixture;
}

argument checked_fixture {
  conclusion fixture_criteria_met;
  reasoning sample_criteria;
  evidence recomputed_sample;
}
