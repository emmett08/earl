language "EAL/2";
environment rig { require "site" == "test-rig-9"; }
tool trace_reader { version "1"; mode deterministic; }
evidence trace_record { tool trace_reader; kind sampled_negative_trace; environment rig; max_age 3600; require "schema" == "EAL/typed-input/1"; }
reasoning checked_search { method "engineering/sampled-negative/1"; rationale "No violation is licensed only for this bounded sampled search and the declared detector contract."; }
reasoning conditional_step { method "structured/1"; rationale "A qualified bounded negative search is one explicit premise of this provisional decision."; }
claim qualified_absence { statement "The completed, sufficiently sensitive sampled search detected no value violating the declared bound."; environment rig;
 proposition { subject "rig-9"; quantity "dimensionless"; unit "1"; scope "vibration-interval-9"; valid_from "2040-01-31T08:00:00Z"; valid_until "2040-01-31T09:00:00Z";
 query {"mode":"non_detection","start":0,"end":12,"max_gap":4,"property":{"operator":"lt","value":1},"semantics":"sampled","detector_contract":{"maximum_detection_limit":0.1,"minimum_sensitivity":0.9}}; result "finding" == true; }
}
claim proceed_within_sampled_contract { statement "The qualified sampled search supplies one declared premise for proceeding under this finite contract."; environment rig; }
argument absence_route { conclusion qualified_absence; reasoning checked_search; evidence trace_record; binding trace_record; }
argument decision_route { conclusion proceed_within_sampled_contract; reasoning conditional_step; premises qualified_absence; }
