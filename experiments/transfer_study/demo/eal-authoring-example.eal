language "EAL/3"

environment orders {
  require service == "orders"
}

tool probe {
  version "1"
}

context environment orders {
  evidence report {
    tool probe
    kind test
    max_age 864000.0
    input {"service": "orders"}
    require ready == true
  }

  reasoning report_check {
    method "structured/1"
    rationale "The scoped report supports readiness under the declared condition."
  }

  claim ready {
    statement "The orders service is ready under this report."
  }

  argument reported_ready = [evidence report] via report_check => ready
}
