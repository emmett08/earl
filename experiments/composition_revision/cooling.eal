// Synthetic bench observations for one coolant loop at an 8 kW load.
language "EAL/2";

environment loop_a {
  require "loop_id" == "coolant-loop-A";
  require "load_kw" == 8;
}

tool bench_instrument { version "1"; }

evidence power_bus {
  tool bench_instrument; kind measurement; environment loop_a; max_age 300;
  require "voltage_v" >= 24;
  require "voltage_v" <= 28;
}

evidence pump_a_flow {
  tool bench_instrument; kind measurement; environment loop_a; max_age 60;
  require "flow_lpm" >= 14;
  require "sensor_id" == "A";
}

evidence pump_b_flow {
  tool bench_instrument; kind measurement; environment loop_a; max_age 60;
  require "flow_lpm" >= 14;
  require "sensor_id" == "B";
}

evidence exchanger_test {
  tool bench_instrument; kind test; environment loop_a; max_age 300;
  require "removed_heat_kw" >= 8;
}

evidence pump_a_disagreement {
  tool bench_instrument; kind test; environment loop_a; max_age 60;
  require "flow_sensors_disagree" == true;
}

reasoning observed_threshold {
  method "structured/1";
  rationale "The synthetic reading meets its stated finite bench threshold; the authored relation to this scoped claim is not a proof of physical performance outside the bench observation.";
}

reasoning combined_capacity {
  method "structured/1";
  rationale "At this bench load, usable supply, an accepted flow route and the measured heat-exchanger result jointly support the scoped cooling statement.";
}

claim power_sufficient {
  statement "The bench supply voltage for coolant-loop-A was between 24 and 28 V at the observed time.";
  environment loop_a;
}

claim flow_sufficient {
  statement "At least one independently instrumented pump route recorded at least 14 L/min for coolant-loop-A at the observed time, conditional on the shared supply.";
  environment loop_a;
}

claim rejection_sufficient {
  statement "The coolant-loop-A heat-exchanger bench result recorded at least 8 kW removed heat at the observed time.";
  environment loop_a;
}

claim cooling_at_8kw {
  statement "The recorded coolant-loop-A bench configuration supports removal of the stated 8 kW load under the observed supply, flow and exchanger conditions.";
  environment loop_a;
}

argument measured_power {
  conclusion power_sufficient; reasoning observed_threshold; evidence power_bus;
}
argument pump_a_route {
  conclusion flow_sufficient; reasoning observed_threshold;
  evidence pump_a_flow; premises power_sufficient;
}
argument pump_b_route {
  conclusion flow_sufficient; reasoning observed_threshold;
  evidence pump_b_flow; premises power_sufficient;
}
argument measured_rejection {
  conclusion rejection_sufficient; reasoning observed_threshold; evidence exchanger_test;
}
argument combined_loop {
  conclusion cooling_at_8kw; reasoning combined_capacity;
  premises flow_sufficient, rejection_sufficient;
}

// A disagreement attacks only the A route; the B route can still support flow.
objection disputed_pump_a {
  target argument pump_a_route;
  evidence pump_a_disagreement;
}
