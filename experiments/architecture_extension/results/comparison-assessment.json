    "causal_account": {
      "backing": [],
      "method": "structured/1",
      "objection_statuses": {},
      "rationale": "EAL context may direct an agent to the existing extension point, but one unrandomised pair cannot separate that mechanism from session variation or ordinary baseline documentation.",
      "reasons": [
        "Method structured/1 and backing are locally available; acceptance is assessed per application"
      ],
