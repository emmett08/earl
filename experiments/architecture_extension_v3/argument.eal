// Host-bound, current-snapshot review. The tool sees the exact candidate tree
// identified in the artifact context. A missing or invalid check fails closed.
language "EAL/2";

environment fulfilment_change {
  require "experiment" == "architecture-extension-v3";
  require "stage" == "current-snapshot";
}

tool snapshot_probe { version "1"; }

evidence source_bound {
  tool snapshot_probe; kind inspection; environment fulfilment_change; max_age 3600;
  input {"check_id":"source_binding"}; require "passed" == true;
}
evidence visible_tests_pass {
  tool snapshot_probe; kind test; environment fulfilment_change; max_age 3600;
  input {"check_id":"visible_tests"}; require "passed" == true;
}
evidence visible_tests_fail {
  tool snapshot_probe; kind test; environment fulfilment_change; max_age 3600;
  input {"check_id":"visible_tests"}; require "passed" == false;
}
evidence imports_acyclic {
  tool snapshot_probe; kind inspection; environment fulfilment_change; max_age 3600;
  input {"check_id":"import_cycles"}; require "passed" == true;
}
evidence imports_cyclic {
  tool snapshot_probe; kind inspection; environment fulfilment_change; max_age 3600;
  input {"check_id":"import_cycles"}; require "passed" == false;
}
evidence shared_boundary_pass {
  tool snapshot_probe; kind inspection; environment fulfilment_change; max_age 3600;
  input {"check_id":"shared_boundary"}; require "passed" == true;
}
evidence shared_boundary_changed {
  tool snapshot_probe; kind inspection; environment fulfilment_change; max_age 3600;
  input {"check_id":"shared_boundary"}; require "passed" == false;
}
evidence public_impact_mapped {
  tool snapshot_probe; kind inspection; environment fulfilment_change; max_age 3600;
  input {"check_id":"shared_boundary"}; require "impact_schema" == "public-feature-surface/1";
}

reasoning source_identity {
  method "structured/1";
  rationale "The host copied the current candidate and checked its full code-tree digest together with the operator-pinned collector bytes. This identifies the assessed source, not its design quality or the sealed final assessor.";
}
reasoning visible_regression {
  method "structured/1";
  rationale "The candidate-visible unittest suite ran against this exact tree. The coding agent can modify these tests, so passing them is only process feedback. A sealed independent assessor runs after the session and never supplies agent-facing evidence.";
}
reasoning import_inspection {
  method "structured/1";
  rationale "The static Python import graph has no detected cycles. Dynamic imports and broader dependency direction still need review.";
}
reasoning boundary_inspection {
  method "structured/1";
  rationale "The current source declares the six original effect ports, injects them into CheckoutService and has no direct memory adapter import in that service. This is a bounded syntactic observation; the collector records effect call sites but cannot certify unique mutations, durable outbox delivery or absence of dead code.";
}
reasoning impact_inspection {
  method "structured/1";
  rationale "A host-pinned review map derived from the public feature briefs and the known A-stage ports lists likely symbols and whether they exist in the current tree. Missing symbols may be new work or a different valid design; neither presence nor absence proves the feature complete.";
}
reasoning migration_decision {
  method "structured/1";
  rationale "A source-bound departure from the former port names can be legitimate. Identify the replacement responsibility and every dependent effect path, then verify behaviour and failure recovery before acceptance. The syntax check alone cannot adjudicate that migration.";
}
reasoning change_review {
  method "structured/1";
  rationale "For this current candidate, review changes against the established order lifecycle, ports, compensation, idempotency and outbox. Extend a suitable shared contract or refactor its dependent paths together when a requirement exceeds the seam. Inspect reported effect call sites for duplicate routes and obsolete paths. Visible tests and a static import graph make it reviewable, not proven correct or debt-free.";
}
reasoning failed_obligation {
  method "structured/1";
  rationale "The named current-snapshot check recorded an explicit negative result. The failure blocks a ready-for-review inference; absence of a record is never interpreted as failure.";
}

claim candidate_identified {
  statement "The independent checks address the immutable candidate identified by the host tree digest.";
  environment fulfilment_change;
}
claim visible_tests_satisfied {
  statement "The candidate passed its visible unittest suite; this does not establish the sealed final behaviour.";
  environment fulfilment_change;
}
claim visible_tests_failed {
  statement "The candidate's visible unittest suite failed or ran no tests.";
  environment fulfilment_change;
}
claim import_graph_acyclic {
  statement "The candidate's parsed production import graph has no detected cycle.";
  environment fulfilment_change;
}
claim import_graph_cyclic {
  statement "The candidate's parsed production import graph contains a cycle.";
  environment fulfilment_change;
}
claim shared_boundary_retained {
  statement "The current candidate retains the declared port boundary and injection syntax; effect routes and idempotency require behavioural and human review.";
  environment fulfilment_change;
}
claim shared_boundary_changed_claim {
  statement "The current candidate differs from the declared port and injection boundary; any intentional migration needs explicit review of all dependent paths.";
  environment fulfilment_change;
}
claim migration_review_required {
  statement "A changed port boundary requires a named migration decision and behavioural verification; the syntactic mismatch alone does not judge the replacement architecture.";
  environment fulfilment_change;
}
claim migration_guidance {
  statement "If the former boundary has changed, review the replacement contract and all callers, compensations, idempotency and outbox effects; conformance remains unknown until those obligations are verified.";
  environment fulfilment_change;
}
claim public_change_surface_mapped {
  statement "The public requirement's likely change surfaces have been checked against current source, with missing and present symbols disclosed for review.";
  environment fulfilment_change;
}
claim current_candidate_reviewable {
  statement "This identified candidate passed its visible tests and static import check. Either the former port syntax remains or a replacement needs explicit contract and dependent-path review. Sealed final behaviour, replacement conformance and future technical debt remain unestablished.";
  environment fulfilment_change;
}

argument identified_source {
  conclusion candidate_identified; reasoning source_identity; evidence source_bound;
}
argument observed_visible_tests_pass {
  conclusion visible_tests_satisfied; reasoning visible_regression; evidence visible_tests_pass;
}
argument observed_visible_tests_fail {
  conclusion visible_tests_failed; reasoning failed_obligation; evidence visible_tests_fail;
}
argument observed_acyclic {
  conclusion import_graph_acyclic; reasoning import_inspection; evidence imports_acyclic;
}
argument observed_cycle {
  conclusion import_graph_cyclic; reasoning failed_obligation; evidence imports_cyclic;
}
argument observed_boundary {
  conclusion shared_boundary_retained; reasoning boundary_inspection; evidence shared_boundary_pass;
}
argument observed_boundary_change {
  conclusion shared_boundary_changed_claim; reasoning failed_obligation; evidence shared_boundary_changed;
}
argument migration_branch {
  conclusion migration_review_required; reasoning boundary_inspection;
  premises candidate_identified, shared_boundary_changed_claim;
}
argument migration_recommendation {
  conclusion migration_guidance; reasoning migration_decision;
  premises candidate_identified, migration_review_required;
}
argument mapped_public_change_surface {
  conclusion public_change_surface_mapped; reasoning impact_inspection; evidence public_impact_mapped;
}
argument current_review {
  conclusion current_candidate_reviewable; reasoning change_review;
  premises candidate_identified, visible_tests_satisfied, import_graph_acyclic,
           shared_boundary_retained, public_change_surface_mapped;
}
argument migration_review {
  conclusion current_candidate_reviewable; reasoning migration_decision;
  premises candidate_identified, visible_tests_satisfied, import_graph_acyclic,
           migration_guidance, public_change_surface_mapped;
}
objection failed_visible_tests {
  target argument current_review; premises visible_tests_failed;
}
objection failed_visible_tests_migration {
  target argument migration_review; premises visible_tests_failed;
}
objection cyclic_import {
  target argument current_review; premises import_graph_cyclic;
}
objection cyclic_import_migration {
  target argument migration_review; premises import_graph_cyclic;
}
objection boundary_migration {
  target argument current_review; premises migration_guidance;
}

// A strict implication records only what the check reported; the tests and
// static analysis remain fallible, limited evidence.
strict observed_visible_tests_fail reviewed "architecture-v3/explicit-negative-visible-test";
strict observed_cycle reviewed "architecture-v3/explicit-negative-import-cycle";
strict observed_boundary_change reviewed "architecture-v3/explicit-boundary-difference";
contrary visible_tests_satisfied to visible_tests_failed reviewed "architecture-v3/opposed-visible-test-verdicts";
contrary visible_tests_failed to visible_tests_satisfied reviewed "architecture-v3/opposed-visible-test-verdicts";
contrary import_graph_acyclic to import_graph_cyclic reviewed "architecture-v3/opposed-cycle-verdicts";
contrary import_graph_cyclic to import_graph_acyclic reviewed "architecture-v3/opposed-cycle-verdicts";
contrary shared_boundary_retained to shared_boundary_changed_claim reviewed "architecture-v3/opposed-boundary-verdicts";
contrary shared_boundary_changed_claim to shared_boundary_retained reviewed "architecture-v3/opposed-boundary-verdicts";
