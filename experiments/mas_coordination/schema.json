          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "recipient": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "reply_to": {
          "type": "null"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        }
