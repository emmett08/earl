{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eal:mas-coordination:1",
  "title": "EAL/MAS-coordination/1",
  "description": "Optional domain payload. MAS Protocol Lab transport envelope and EAL language versions remain separate.",
  "$defs": {
    "scope": {
      "type": "object",
      "properties": {
        "entry_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z_][A-Za-z_0-9.-]*$"
        },
        "claim": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z_][A-Za-z_0-9]*(\\.[A-Za-z_][A-Za-z_0-9]*)*$"
        },
        "source_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "context_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "method_registry_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "assessed_at": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        }
      },
      "required": [
        "entry_id",
        "claim",
        "source_digest",
        "context_fingerprint",
        "method_registry_fingerprint",
        "assessed_at"
      ],
      "additionalProperties": false
    }
  },
  "oneOf": [
