      "type": "object",
      "properties": {
        "schema": {
          "const": "EAL/MAS-coordination/1"
        },
        "kind": {
          "const": "assessment_request"
        },
        "message_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "sender": {
          "type": "string",
