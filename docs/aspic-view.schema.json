    "execution_limits": {
      "type": "object",
      "properties": {
        "source_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "source_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "structural_values": {
          "type": "integer",
          "minimum": 1
        },
        "declarations": {
          "type": "integer",
          "minimum": 1
        },
        "premise_depth": {
          "type": "integer",
          "minimum": 1
        },
        "expansion_depth": {
          "type": "integer",
          "minimum": 1
        },
        "applications": {
          "type": "integer",
          "minimum": 1
        },
        "expanded_references": {
          "type": "integer",
          "minimum": 1
        },
        "expression_nodes": {
          "type": "integer",
          "minimum": 1
        },
        "expression_depth": {
          "type": "integer",
          "minimum": 1
        },
        "json_depth": {
          "type": "integer",
          "minimum": 1
        },
        "json_nodes": {
          "type": "integer",
          "minimum": 1
        },
        "record_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "collection_evidence": {
          "type": "integer",
          "minimum": 1
        },
        "composed_edges": {
          "type": "integer",
          "minimum": 1
        },
        "abstract_attacks": {
          "type": "integer",
          "minimum": 1
        },
        "formal_premises": {
          "type": "integer",
          "minimum": 1
        },
        "formal_rules": {
          "type": "integer",
          "minimum": 1
        },
        "formal_antecedents": {
          "type": "integer",
          "minimum": 1
        },
        "formal_atoms": {
          "type": "integer",
          "minimum": 1
        },
        "formal_contraries": {
          "type": "integer",
          "minimum": 1
        },
        "formal_arguments": {
          "type": "integer",
          "minimum": 1
        },
        "formal_defeats": {
          "type": "integer",
          "minimum": 1
        },
        "formal_construction": {
          "type": "integer",
          "minimum": 1
        },
        "extension_search": {
          "type": "integer",
          "minimum": 1
        }
