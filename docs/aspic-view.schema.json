        "source_tokens",
        "structural_values",
        "declarations",
        "premise_depth",
        "expansion_depth",
        "applications",
        "expanded_references",
        "expression_nodes",
        "expression_depth",
        "json_depth",
        "json_nodes",
        "record_bytes",
        "collection_evidence",
        "composed_edges",
