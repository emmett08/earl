      "minLength": 1,
      "maxLength": 100000
    },
    "goal_claim": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 100000
        },
        {
          "type": "null"
        }
      ]
    },
    "formal_status": {
      "type": "string",
      "enum": [
        "accepted",
        "rejected",
        "undecided",
        "unconstructed"
      ]
    },
    "semantics": {
      "type": "string",
      "enum": [
        "grounded",
        "preferred",
        "stable"
      ]
    },
    "query_mode": {
